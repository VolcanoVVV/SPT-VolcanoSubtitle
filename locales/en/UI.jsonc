    "弹幕 字体描边水平位移（Y轴）": { "Name": "Outline offset Y", "Desc": "Vertical outline offset in pixels." },
    "弹幕 字体阴影": { "Name": "Shadow", "Desc": "Enable danmaku text shadow." },
