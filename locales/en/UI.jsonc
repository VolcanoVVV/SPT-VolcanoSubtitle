    "弹幕 字体阴影叠乘文本透明度": { "Name": "Multiply shadow by text alpha", "Desc": "Multiply shadow opacity by text opacity." },
    "弹幕 车道数量": { "Name": "Lane count", "Desc": "Number of available danmaku lanes." },
    "弹幕 密度倍率": { "Name": "Density multiplier", "Desc": "Globally adjusts danmaku density (0.25-3.0). Higher values reduce spawn intervals and same-lane gaps; lane count and screen area remain hard limits." },
    "弹幕 不透明度": { "Name": "Opacity", "Desc": "Opacity of the complete danmaku line (0.1-1.0), including text, rich-text role label, outline, and shadow." },
    "弹幕 速度（px/s）": { "Name": "Speed (px/s)", "Desc": "Base danmaku movement speed in pixels per second." },
    "弹幕 按台词长度加速": { "Name": "Accelerate long phrases", "Desc": "Increase movement speed as visible character count grows, reducing the time very long danmaku occupies the screen." },
    "弹幕 长度加速倍率": { "Name": "Length acceleration multiplier", "Desc": "Strength of each length-based speed increase (0-2)." },
    "弹幕 长度加速起始字数": { "Name": "Acceleration start length", "Desc": "Start applying length-based acceleration after this many visible characters." },
    "弹幕 每级加速字数": { "Name": "Characters per acceleration step", "Desc": "Apply another acceleration increment for each additional block of this many characters." },
    "弹幕 长度加速上限倍率": { "Name": "Maximum accelerated speed", "Desc": "Maximum final speed as a multiple of base speed." },
    "弹幕 车道垂直间距（px）": { "Name": "Vertical lane spacing (px)", "Desc": "Extra vertical spacing between adjacent danmaku lanes." },
    "弹幕 同车道最小间隔": { "Name": "Minimum same-lane gap", "Desc": "Minimum horizontal gap in pixels between danmaku lines in the same lane." },
    "弹幕 新弹幕输出间隔（秒）": { "Name": "Spawn interval (s)", "Desc": "Minimum interval between new danmaku lines. Recommended: 0.1-0.3 seconds." },
    "弹幕 顶部起始位置（相对）": { "Name": "Top start position", "Desc": "Relative vertical start position below the top of the screen (0-0.5; default: 0.10)." },
    "弹幕 最大垂直占比": { "Name": "Maximum vertical coverage", "Desc": "Maximum fraction of screen height available to danmaku (0-1; default: 0.35)." },

    "3D气泡 显示说话者": { "Name": "Show speaker", "Desc": "Show the speaker label in 3D bubbles. When disabled, only the phrase text and optional distance are shown." },
    "3D气泡 显示PMC名字": { "Name": "Show PMC name", "Desc": "Show the PMC's in-game nickname." },
    "3D气泡 显示Scav名字": { "Name": "Show Scav name", "Desc": "Show the Scav's in-game name. Not recommended because long Scav names can make bubbles harder to read." },
    "3D气泡 玩家说话代称": { "Name": "Local player label", "Desc": "Label style when the local player speaks: short label, player nickname, or voice name." },
    "3D气泡 队友说话代称": { "Name": "Teammate label", "Desc": "Label style when a teammate speaks: short label, player nickname, or voice name." },
    "3D气泡 最大语音接收距离（米）": { "Name": "Maximum voice range (m)", "Desc": "Do not display 3D bubbles from sources beyond this distance. Range: 10-150 m; default: 30 m." },
    "3D气泡 同时显示最大角色数": { "Name": "Maximum visible characters", "Desc": "Maximum number of characters with active 3D bubbles in range (0-50; 0 is unlimited). When full, characters closer to the current camera are retained." },
    "3D气泡 显示距离": { "Name": "Show distance", "Desc": "Append the source distance, for example ' - 10m'." },
    "3D气泡 台词显示延迟（秒）": { "Name": "Additional display time (s)", "Desc": "Keeps a 3D bubble visible for extra time after its voice clip ends." },
    "3D气泡 垂直偏移（米）": { "Name": "Vertical offset (m)", "Desc": "Moves the complete bubble up or down in world space. Positive values move it upward." },
    "3D气泡 朝向玩家": { "Name": "Face player", "Desc": "Keep bubbles facing the player's camera." },
    "3D气泡 背景": { "Name": "Background", "Desc": "Show a background behind 3D bubble text." },
    "3D气泡 背景颜色": { "Name": "Background color", "Desc": "3D bubble background color, including opacity." },
    "3D气泡 显示自己": { "Name": "Show local player", "Desc": "Show a 3D bubble when the local player speaks." },
    "3D气泡 丧尸显示台词（除 丧尸Tagilla）": { "Name": "Show infected phrases (except infected Tagilla)", "Desc": "Show phrases from regular infected characters. This does not affect infected Tagilla." },
    "3D气泡 丧尸台词间隔（秒）": { "Name": "Infected phrase cooldown (s)", "Desc": "Minimum interval between infected phrases. 0 disables the limit; 5-10 seconds or more is recommended." },
