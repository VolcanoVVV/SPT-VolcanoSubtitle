    "3D气泡 启用距离尺寸补偿": { "Name": "Enable distance-size compensation", "Desc": "Adjust world scale by viewing distance: smaller nearby and larger far away, keeping the on-screen bubble size more stable." },
    "3D气泡 距离补偿基准（米）": { "Name": "Distance reference (m)", "Desc": "Use the original world scale at this distance. Bubbles shrink closer than this and enlarge farther away." },
    "3D气泡 距离补偿最小倍率": { "Name": "Minimum distance multiplier", "Desc": "Minimum scale multiplier allowed when shrinking nearby bubbles (0.1-1.0)." },
    "3D气泡 距离补偿最大倍率": { "Name": "Maximum distance multiplier", "Desc": "Maximum scale multiplier allowed when enlarging distant bubbles (1.0-8.0)." },
    "3D气泡 世界缩放": { "Name": "World scale", "Desc": "World-space scale factor. Larger values are clearer and also physically larger. Default: 0.01." },
    "3D气泡 动态像素密度": { "Name": "Dynamic pixel density", "Desc": "CanvasScaler.dynamicPixelsPerUnit. Higher values improve clarity but cost more performance." },
    "3D气泡 朝向更新间隔（秒）": { "Name": "Facing update interval (s)", "Desc": "0 updates camera-facing rotation every frame. Higher values update at intervals to reduce jitter and blur." },
    "3D气泡 叠加最大行数": { "Name": "Maximum stacked lines", "Desc": "Maximum number of lines stacked when the same character speaks repeatedly." },
    "3D气泡 叠加上移间距": { "Name": "Stack vertical spacing", "Desc": "Vertical world-space offset applied between stacked lines." },
    "3D气泡 淡入时长（秒）": { "Name": "Fade-in duration (s)", "Desc": "Time used to fade in a 3D bubble." },
    "3D气泡 淡出时长（秒）": { "Name": "Fade-out duration (s)", "Desc": "Time used to fade out a 3D bubble." },
    "3D气泡 最大文本宽度（px）": { "Name": "Maximum text width (px)", "Desc": "Maximum canvas width of the bubble text area. Wrapped text is laid out within this width." },
    "3D气泡 水平内边距（px）": { "Name": "Horizontal padding (px)", "Desc": "Distance between text and the left/right edges of the bubble background." },
    "3D气泡 垂直内边距（px）": { "Name": "Vertical padding (px)", "Desc": "Distance between text and the top/bottom edges of the bubble background." },
    "3D气泡 最长显示时长（秒）": { "Name": "Maximum lifetime (s)", "Desc": "Maximum lifetime of one 3D bubble, preventing abnormal voice durations from occupying a character indefinitely." },
    "3D气泡 启用跟随平滑": { "Name": "Enable follow smoothing", "Desc": "Smooth bubble position and camera-facing rotation to reduce bone jitter. Disable for immediate tracking." },
    "3D气泡 位置跟随速度": { "Name": "Position follow speed", "Desc": "Position response speed while smoothing is enabled. Higher values follow the character more tightly." },
    "3D气泡 朝向跟随速度": { "Name": "Rotation follow speed", "Desc": "Camera-facing rotation response speed while smoothing is enabled. Higher values turn faster." },

