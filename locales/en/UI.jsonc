    "3D气泡 字体类型": { "Name": "Font families", "Desc": "Ordered font fallback list separated by commas or semicolons. Use game:FontName for a built-in game font." },
    "3D气泡 字体尺寸（px）": { "Name": "Font size (px)", "Desc": "3D bubble font size in pixels." },
    "3D气泡 优先使用SDF字体": { "Name": "Prefer SDF font", "Desc": "Prefer a TextMeshPro SDF font from the selected font bundle for better distance clarity. Automatically falls back to legacy Text when no compatible SDF font is available." },
    "3D气泡 字体加粗": { "Name": "Bold", "Desc": "Use bold 3D bubble text." },
    "3D气泡 字体斜体": { "Name": "Italic", "Desc": "Use italic 3D bubble text." },
    "3D气泡 文本对齐": { "Name": "Text alignment", "Desc": "Alignment of 3D bubble text." },
