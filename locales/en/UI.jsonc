  "Settings": {
    "文本样式预设": { "Name": "Text style preset", "Desc": "Loads all .jsonc presets from the presets folder. Apply imports every option included in the selected preset." },
    "界面 语言": { "Name": "Language", "Desc": "Language folder under locales used by the interface and localized resources. Changes apply immediately; missing files fall back to ch." },
    "字幕启用": { "Name": "Enable subtitles", "Desc": "Enable the standard subtitle channel." },
    "弹幕启动": { "Name": "Enable danmaku", "Desc": "Enable scrolling danmaku subtitles." },
    "3D气泡启用": { "Name": "Enable 3D bubbles", "Desc": "Enable world-space 3D speech bubbles." },
    "主播模式启用": { "Name": "Enable streamer mode", "Desc": "Masks profanity in subtitles, danmaku, 3D bubbles, and map broadcasts. The word list is locales/<language>/StreamerWords.jsonc and falls back to ch." },
    "主播模式 打码样式": { "Name": "Mask style", "Desc": "Streamer-mode replacement style: equal-length asterisks, equal-length blocks, or a whole-word grawlix." },
    "图形化设置界面": { "Name": "Graphical settings", "Desc": "Open the graphical settings window. F12 keeps only this entry and the hotkey entry below." },
    "设置界面 打开热键": { "Name": "Settings window hotkey", "Desc": "Hotkey used to open or close the graphical settings window. Default: F9." },
    "台词显示控制面板": { "Name": "Phrase Filter", "Desc": "Open the Phrase Filter to configure display rules by voice, trigger, and NetId." },
    "界面与文字缩放": { "Name": "Interface and text scale", "Desc": "Overall scale of the settings window and Phrase Filter (0.75-1.30). Scales text, buttons, and spacing for high-resolution displays or distant viewing." },
    "设置界面 不透明度": { "Name": "Interface opacity", "Desc": "Overall opacity of the graphical settings window and Phrase Filter (0.2-1.0)." },
    "▶ 随机测试字幕": { "Name": "> Random subtitle test", "Desc": "Display one random test subtitle." },
    "▶ 随机测试弹幕（3条）": { "Name": "> Random danmaku test (3 lines)", "Desc": "Display three random test danmaku lines." },
    "展开/收缩 字幕 选项设置": { "Name": "Expand/collapse subtitle options", "Desc": "Expand or collapse subtitle options." },
    "展开/收缩 弹幕 选项设置": { "Name": "Expand/collapse danmaku options", "Desc": "Expand or collapse danmaku options." },
    "展开/收缩 3D气泡 选项设置": { "Name": "Expand/collapse 3D bubble options", "Desc": "Expand or collapse 3D bubble options." },

    "字幕 显示说话者": { "Name": "Show speaker", "Desc": "Show the speaker label in standard subtitles. When disabled, only the phrase text and optional distance are shown." },
    "字幕 显示PMC名字": { "Name": "Show PMC name", "Desc": "Show the PMC's in-game nickname." },
    "字幕 显示Scav名字": { "Name": "Show Scav name", "Desc": "Show the Scav's in-game name. Not recommended because long Scav names can make subtitles harder to read." },
    "字幕 玩家说话代称": { "Name": "Local player label", "Desc": "Label style when the local player speaks: short label, player nickname, or voice name such as Michael." },
    "字幕 队友说话代称": { "Name": "Teammate label", "Desc": "Label style when a teammate speaks: short label, player nickname, or voice name such as Michael." },
    "字幕 最大语音接收距离（米）": { "Name": "Maximum voice range (m)", "Desc": "Do not display standard subtitles from other players or AI beyond this distance. Range: 10-150 m; default: 30 m." },
    "字幕 显示距离": { "Name": "Show distance", "Desc": "Append the source distance, for example ' - 10m'." },
    "字幕 台词显示延迟（秒）": { "Name": "Additional display time (s)", "Desc": "Keeps a subtitle visible for extra time after its voice clip ends, preventing very short lines from disappearing immediately." },
    "字幕 启用淡入淡出动画": { "Name": "Enable fade animation", "Desc": "Animate subtitle opacity and row-height expansion/collapse. When disabled, subtitles appear and leave immediately." },
    "字幕 淡入时长（秒）": { "Name": "Fade-in duration (s)", "Desc": "Time used to fade in and expand a standard subtitle row." },
    "字幕 淡出时长（秒）": { "Name": "Fade-out duration (s)", "Desc": "Time used to fade out and collapse a standard subtitle row." },
    "字幕 启用阅读时间补偿": { "Name": "Enable reading-time compensation", "Desc": "Extends subtitle lifetime according to visible character count so long lines do not disappear too early." },
    "字幕 最短阅读时长（秒）": { "Name": "Minimum reading time (s)", "Desc": "Minimum lifetime of any subtitle while reading-time compensation is enabled." },
    "字幕 阅读固定补偿（秒）": { "Name": "Fixed reading allowance (s)", "Desc": "Extra fixed time added to the character-based reading estimate for eye movement and comprehension." },
    "字幕 阅读速度（字符/秒）": { "Name": "Reading speed (characters/s)", "Desc": "Lower values produce longer character-based subtitle lifetimes." },
    "字幕 阅读补偿最长时长（秒）": { "Name": "Maximum compensated time (s)", "Desc": "Maximum reading time granted to normal phrases. Long scrolling phrases still remain until their full scroll completes." },
    "字幕 普通滚动速度（字符/秒）": { "Name": "Normal marquee speed (characters/s)", "Desc": "Scroll speed for single-line marquee text not handled by the dedicated long-phrase rule. Converted to pixels using font size." },
    "字幕 普通滚动句尾停留（秒）": { "Name": "Normal marquee end hold (s)", "Desc": "Additional time held at the end of a normal marquee before fading out." },
    "字幕 同时显示最大条数": { "Name": "Maximum visible lines", "Desc": "Maximum number of standard subtitle lines shown at once (1-10). At the limit, role priority decides whether a line is replaced or ignored." },
    "字幕 启用角色显示优先级": { "Name": "Enable role priority", "Desc": "When visible lines exceed the limit, higher-priority roles are retained. Newer lines win when priorities are equal. Disable to treat all roles equally." },
    "字幕 优先级 玩家": { "Name": "Priority - Player", "Desc": "Display priority for the local player (0-100; higher values take priority)." },
    "字幕 优先级 队友": { "Name": "Priority - Teammate", "Desc": "Display priority for teammates (0-100)." },
    "字幕 优先级 PMC": { "Name": "Priority - PMC", "Desc": "Display priority for BEAR and USEC PMCs (0-100)." },
    "字幕 优先级 Scav": { "Name": "Priority - Scav", "Desc": "Display priority for regular Scavs (0-100)." },
    "字幕 优先级 Raider与Rogue": { "Name": "Priority - Raider and Rogue", "Desc": "Display priority for Raiders and Rogues (0-100)." },
    "字幕 优先级 邪教徒": { "Name": "Priority - Cultist", "Desc": "Display priority for Cultists (0-100)." },
    "字幕 优先级 Boss小弟": { "Name": "Priority - Boss follower", "Desc": "Display priority for boss followers (0-100)." },
    "字幕 优先级 丧尸": { "Name": "Priority - Infected", "Desc": "Display priority for regular infected characters (0-100)." },
    "字幕 优先级 三狗": { "Name": "Priority - Goons", "Desc": "Display priority for the Goons (0-100)." },
    "字幕 优先级 Boss": { "Name": "Priority - Boss", "Desc": "Display priority for bosses (0-100)." },
    "字幕 优先级 其他角色": { "Name": "Priority - Other", "Desc": "Display priority for unclassified roles and map broadcasts (0-100)." },
    "字幕 启动实验室广播": { "Name": "Enable Labs announcements", "Desc": "Show map-wide Labs switch and extraction announcements as standard subtitles." },
    "字幕 丧尸显示台词（除 丧尸Tagilla）": { "Name": "Show infected phrases (except infected Tagilla)", "Desc": "Show phrases from regular infected characters. This does not affect infected Tagilla." },
    "字幕 丧尸台词间隔（秒）": { "Name": "Infected phrase cooldown (s)", "Desc": "Minimum interval between infected phrases. Other infected phrases are ignored during this window. 0 disables the limit; 5-10 seconds or more is recommended." },

    "字幕 字体资源包": { "Name": "Font bundle", "Desc": "Select a font bundle from BepInEx\\plugins\\FontReplace\\Font. Leave blank to use the fallback font list." },
    "字幕 字体类型": { "Name": "Font families", "Desc": "Ordered font fallback list separated by commas or semicolons. Use game:FontName for a built-in game font; Arial is the final fallback." },
    "字幕 字体尺寸（px）": { "Name": "Font size (px)", "Desc": "Standard subtitle font size in pixels." },
    "字幕 字体加粗": { "Name": "Bold", "Desc": "Use bold subtitle text." },
    "字幕 字体斜体": { "Name": "Italic", "Desc": "Use italic subtitle text." },
    "字幕 文本对齐": { "Name": "Text alignment", "Desc": "Alignment of subtitle text." },
    "字幕 自动换行": { "Name": "Word wrap", "Desc": "Wrap subtitle text according to the length setting below." },
    "字幕 自动换行长度阈值": { "Name": "Wrap length threshold", "Desc": "Force a line break after this many visible characters. 0 disables the character threshold." },
    "字幕 台词长度上限": { "Name": "Phrase length limit", "Desc": "Maximum visible characters per line. 0 is unlimited. With wrapping enabled this limits line width; without wrapping, overflow scrolls or is truncated." },
    "字幕 超长滚动显示": { "Name": "Scroll overflowing lines", "Desc": "When wrapping is disabled and a phrase exceeds the length limit, scroll the complete phrase inside a fixed-width window. Otherwise truncate it with an ellipsis." },
    "字幕 自动处理超长台词": { "Name": "Handle very long phrases automatically", "Desc": "When a phrase reaches the configured length, stop increasing row height and scroll the full text in a fixed-width window. Intended for unusually long Scav lines." },
    "字幕 超长台词触发字数": { "Name": "Long-phrase threshold", "Desc": "Switch to the dedicated scrolling window when visible character count reaches this value (40-300)." },
    "字幕 超长台词窗口字数": { "Name": "Long-phrase window width", "Desc": "Approximate number of CJK-width characters visible in the scrolling window. Actual width remains limited by screen safety bounds (20-100)." },
    "字幕 超长台词滚动速度": { "Name": "Long-phrase scroll speed", "Desc": "Approximate visible characters scrolled per second (2-20). Lower values provide more reading time." },
    "字幕 超长台词句尾停留": { "Name": "Long-phrase end hold", "Desc": "Additional seconds held after a long phrase reaches its end (0.3-3.0)." },
    "字幕 字体描边": { "Name": "Outline", "Desc": "Enable text outline." },
