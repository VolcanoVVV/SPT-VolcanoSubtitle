    "字幕 字体阴影": { "Name": "Shadow", "Desc": "Enable text shadow." },
    "字幕 字体阴影颜色": { "Name": "Shadow color", "Desc": "Text shadow color." },
    "字幕 字体阴影位移（X轴）": { "Name": "Shadow offset X", "Desc": "Horizontal shadow offset in pixels." },
    "字幕 字体阴影位移（Y轴）": { "Name": "Shadow offset Y", "Desc": "Vertical shadow offset in pixels." },
    "字幕 字体阴影叠乘文本透明度": { "Name": "Multiply shadow by text alpha", "Desc": "Multiply shadow opacity by text opacity." },
    "字幕 布局锚点": { "Name": "Layout anchor", "Desc": "Screen anchor used by the subtitle layout." },
    "字幕 布局锚点位移（X轴）": { "Name": "Anchor offset X", "Desc": "Horizontal offset from the anchor in pixels." },
    "字幕 布局锚点位移（Y轴）": { "Name": "Anchor offset Y", "Desc": "Vertical offset from the anchor in pixels." },
    "字幕 布局安全区": { "Name": "Respect safe area", "Desc": "Keep subtitle layout inside the screen safe area." },
    "字幕 布局最大宽度占比": { "Name": "Maximum width ratio", "Desc": "Maximum measured text width as a fraction of screen width (0-1)." },
    "字幕 布局行距": { "Name": "Line spacing", "Desc": "Additional line spacing in pixels." },
    "字幕 布局覆盖文本对齐": { "Name": "Override text alignment", "Desc": "Optionally force text alignment. No override keeps the text setting." },
    "字幕 布局底部堆叠上移": { "Name": "Bottom stack offset", "Desc": "Relative height of the subtitle stack above the bottom of the screen (0-0.5)." },
    "字幕 文本背景": { "Name": "Text background", "Desc": "Enable the strip-style subtitle background." },
    "字幕 文本背景贴合": { "Name": "Background fit mode", "Desc": "Use text to fit the background to text, or fullRow for a fixed-width row." },
    "字幕 文本背景颜色": { "Name": "Background color", "Desc": "Subtitle background color." },
    "字幕 文本背景内边距 X": { "Name": "Background padding X", "Desc": "Horizontal background padding in pixels." },
    "字幕 文本背景内边距 Y": { "Name": "Background padding Y", "Desc": "Vertical background padding in pixels." },
    "字幕 文本背景外边距 Y": { "Name": "Background margin Y", "Desc": "Vertical background margin in pixels." },
    "字幕 文本背景九宫格名": { "Name": "Background sliced-sprite name", "Desc": "Optional sliced-sprite resource name for the background." },
    "字幕 背景阴影": { "Name": "Background shadow", "Desc": "Enable the background drop shadow." },
    "字幕 背景阴影颜色": { "Name": "Background shadow color", "Desc": "Background drop-shadow color." },
    "字幕 背景阴影水平偏移 X": { "Name": "Background shadow offset X", "Desc": "Horizontal background shadow offset in pixels." },
    "字幕 背景阴影叠乘文字透明度": { "Name": "Multiply background shadow by text alpha", "Desc": "Multiply background shadow opacity by text opacity." },

    "弹幕 显示说话者": { "Name": "Show speaker", "Desc": "Show the speaker label in danmaku. When disabled, only the phrase text is shown." },
    "弹幕 显示PMC名字": { "Name": "Show PMC name", "Desc": "Show the PMC's in-game nickname." },
    "弹幕 显示Scav名字": { "Name": "Show Scav name", "Desc": "Show the Scav's in-game name. Not recommended because long Scav names can make lines harder to read." },
    "弹幕 玩家说话代称": { "Name": "Local player label", "Desc": "Label style when the local player speaks: short label, player nickname, or voice name." },
    "弹幕 队友说话代称": { "Name": "Teammate label", "Desc": "Label style when a teammate speaks: short label, player nickname, or voice name." },
    "弹幕 最大语音接收距离（米）": { "Name": "Maximum voice range (m)", "Desc": "Do not display danmaku from sources beyond this distance. Range: 10-150 m; default: 100 m." },
    "弹幕 显示距离": { "Name": "Show distance", "Desc": "Append the source distance, for example ' - 10m'." },
    "弹幕 启动实验室广播": { "Name": "Enable Labs announcements", "Desc": "Show map-wide Labs switch and extraction announcements as danmaku." },
    "弹幕 丧尸显示台词（除 丧尸Tagilla）": { "Name": "Show infected phrases (except infected Tagilla)", "Desc": "Show phrases from regular infected characters. This does not affect infected Tagilla." },
    "弹幕 丧尸台词间隔（秒）": { "Name": "Infected phrase cooldown (s)", "Desc": "Minimum interval between infected phrases. 0 disables the limit; 5-10 seconds or more is recommended." },
    "弹幕 字体资源包": { "Name": "Font bundle", "Desc": "Select a font bundle from BepInEx\\plugins\\FontReplace\\Font. Leave blank to use the fallback font list." },
    "弹幕 字体类型": { "Name": "Font families", "Desc": "Ordered font fallback list separated by commas or semicolons. Use game:FontName for a built-in game font; Arial is the final fallback." },
