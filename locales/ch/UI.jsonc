  "Settings": {

    // —— 1. 通用 ——
    "文本样式预设": { "Name": "文本样式预设", "Desc": "从 presets 文件夹读取所有 .jsonc预设文件。点击“应用”后，会将预设中所有包含选项一次性导入本配置。" },
    "界面 语言": { "Name": "语言", "Desc": "界面与字幕资源使用的语言（locales 下的语言目录名，如 ch）。\n切换后立即重载界面、台词、角色名、广播与主播词表；缺失文件回退 ch。" },
    "字幕启用": { "Name": "字幕启用", "Desc": "是否启用字幕功能。" },
    "弹幕启动": { "Name": "弹幕启动", "Desc": "启用弹幕显示。" },
    "3D气泡启用": { "Name": "3D气泡启用", "Desc": "启用 3D 气泡显示。" },
