    "弹幕 新弹幕输出间隔（秒）": { "Name": "新弹幕输出间隔（秒）", "Desc": "两条弹幕之间的最小发送间隔（秒）。建议 0.1~0.3。" },
    "弹幕 顶部起始位置（相对）": { "Name": "顶部起始位置（相对）", "Desc": "弹幕距屏幕顶部的相对起始高度（0~0.5，默认 0.10）。" },
    "弹幕 最大垂直占比": { "Name": "最大垂直占比", "Desc": "弹幕允许占用的最大垂直高度（0~1，默认 0.35）。" },

    // —— 3 弹幕 - 通用 ——
    "弹幕 显示说话者": { "Name": "显示说话者", "Desc": "是否在弹幕中显示说话者（例如“你/Scav/Tagilla：”）。关闭后仅显示台词文本。" },
    "弹幕 显示PMC名字": { "Name": "显示PMC名字", "Desc": "是否显示PMC游戏内的ID" },
    "弹幕 显示Scav名字": { "Name": "显示Scav名字", "Desc": "是否显示Scav游戏内的ID\n不推荐，因为Scav游戏名字太长可能会导致台词观感很差。" },
    "弹幕 玩家说话代称": { "Name": "玩家说话代称", "Desc": "当玩家自己说话时弹幕显示风格：\n- 略称：始终显示“你”。\n- 玩家名：显示该玩家昵称。\n- 声线名：显示声线标签（如 Michael）。" },
    "弹幕 队友说话代称": { "Name": "队友说话代称", "Desc": "当友军（队友）说话时弹幕显示风格：\n- 略称：始终显示“队友”。\n- 玩家名：显示该玩家昵称。\n- 声线名：显示声线标签（如 Michael）。" },
    "弹幕 最大语音接收距离（米）": { "Name": "最大语音接收距离（米）", "Desc": "当语音来源距离玩家超过该距离时，不显示弹幕\n10~150 米，默认 100 米。" },
    "弹幕 显示距离": { "Name": "显示距离", "Desc": "是否显示距离。开启后，会在语音后面添加一个类似“ ·10m”的字样" },
    "弹幕 启动实验室广播": { "Name": "启动实验室广播", "Desc": "启用后会把 实验室公共播报 显示为字幕（即实验室拉闸/开关的全图播报）。" },
    "弹幕 丧尸显示台词（除 丧尸Tagilla）": { "Name": "丧尸显示台词（除 丧尸Tagilla）", "Desc": "丧尸台词是否显示（不影响 丧尸Tagilla）。开启则正常显示丧尸台词，关闭则不显示所有普通丧尸的台词" },
    "弹幕 丧尸台词间隔（秒）": { "Name": "丧尸台词间隔（秒）", "Desc": "丧尸类台词的最小间隔（秒）。第一条丧尸台词出现后，在此设置时间区间内其它丧尸台词会被忽略。\n0 表示不限制。推荐5-10以上，否则会导致大量的台词刷屏。" },

