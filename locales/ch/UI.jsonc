    // —— 2 字幕 - 通用 ——
    "字幕 显示说话者": { "Name": "显示说话者", "Desc": "是否在字幕中显示说话者（roletag）。关闭后仅显示台词文本（及距离）\n开启：显示“你/Scav/Tagilla：”。关闭：只显示台词（可选加距离）。" },
    "字幕 显示PMC名字": { "Name": "显示PMC名字", "Desc": "是否显示PMC游戏内的ID" },
    "字幕 显示Scav名字": { "Name": "显示Scav名字", "Desc": "是否显示Scav游戏内的ID\n不推荐，因为Scav游戏名字太长可能会导致台词观感很差。" },
    "字幕 玩家说话代称": { "Name": "玩家说话代称", "Desc": "当玩家自己说话时字幕显示风格：\n- 略称：始终显示“你”。\n- 玩家名：显示该玩家昵称。\n- 声线名：显示声线标签（如 Michael）。" },
    "字幕 队友说话代称": { "Name": "队友说话代称", "Desc": "当友军（队友）说话时字幕显示风格：\n- 略称：始终显示“队友”。\n- 玩家名：显示该玩家昵称。\n- 声线名：显示声线标签（如 Michael）。" },
    "字幕 最大语音接收距离（米）": { "Name": "最大语音接收距离（米）", "Desc": "当语音（其他玩家/AI）来源距离玩家超过该距离时，不显示字幕。\n10~150 米，默认 30 米" },
    "字幕 显示距离": { "Name": "显示距离", "Desc": "是否显示距离。开启后，会在语音后面添加一个类似“ ·10m”的字样" },
    "字幕 台词显示延迟（秒）": { "Name": "台词显示延迟（秒）", "Desc": "字幕显示后，额外延迟消失的秒数，避免短语音瞬间出现又消失。" },
    "字幕 启动实验室广播": { "Name": "启动实验室广播", "Desc": "启用后会把 实验室公共播报 显示为字幕（即实验室拉闸/开关的全图播报）。" },
    "字幕 丧尸显示台词（除 丧尸Tagilla）": { "Name": "丧尸显示台词（除 丧尸Tagilla）", "Desc": "丧尸台词是否显示（不影响 丧尸Tagilla）。开启则正常显示丧尸台词，关闭则不显示所有普通丧尸的台词" },
    "字幕 丧尸台词间隔（秒）": { "Name": "丧尸台词间隔（秒）", "Desc": "丧尸类台词的最小间隔（秒）。第一条丧尸台词出现后，在此设置时间区间内其它丧尸台词会被忽略。\n0 表示不限制。推荐5-10以上，否则会导致大量的台词刷屏。" },

