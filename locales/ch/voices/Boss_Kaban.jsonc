  "OnEnemyDown": {
    "0": "拒收菜逼。",
    "1": "干得漂亮，兄弟们！",
    "2": "我给你们钱可不是白送的。",
    "3": "把他当叶子飞了！",
    "4": "搞定一个。"
  },
  "OnEnemyGrenade": {
    "0": "手雷来了！规避！",
    "1": "手雷！趴下！",
    "2": "快走开！",
    "3": "快走！快走！"
  },
  "OnEnemyShot": {
    "0": "怎么，要哭鼻子了吗？",
    "1": "砰！给你肚子开个西瓜洞！呵呵哈哈哈。",
    "2": "打中了！打中了！哈哈哈。",
    "3": "搞定，这傻逼的防弹衣现在成榨汁机了！",
    "4": "看好了，这伤口的血还没流干呢。",
    "5": "你他妈能不能快点！"
  },
  "OnFirstContact": {
    "0": "来欣赏一下这个吧！",
    "1": "狗东西！"
  },
  "OnFriendlyDown": {
    "0": "损失一名狙击手，该死的！",
    "1": "迪蒙！迪蒙！！！",
    "2": "情况不妙！",
    "3": "麻子去哪儿了！怎么死的？妈的！",
    "4": "那个PMC疯了！他把我们的人杀了！必须弄死他！",
    "5": "我的兄弟们！你个混蛋东西！",
    "6": "我们减员了。",
    "7": "我们的小兄弟被他们给做了！",
    "8": "我们的人被杀了！"
  },
  "OnGoodWork": {
    "0": "到此为止了，给你送终了。",
    "1": "吃到枪子了？对吧？"
  },
  "OnGrenade": {
    "0": "马上给你整个大的！",
    "1": "哈哈哈，送你份大礼！",
    "2": "接好了！",
    "3": "这是给你的，亲爱的！"
  },
  "OnLostVisual": {
    "0": "来玩捉迷藏吧！呵呵哈哈！",
    "1": "不要躲起来。",
    "2": "老子喂你吃屎，你就得张嘴！",
    "3": "出来单挑啊！",
    "4": "这就怂了？给老子滚回来！",
    "5": "一二三，Kaban要来铲除你们了！",
    "6": "干得好！"
  },
  "OnMutter": {
    "0": "(口哨声)",
    "1": "妈的，现在要是能泡个澡，再搂俩妞儿该多爽。喝哈哈...",
    "2": "兄弟们，都打起精神。",
    "3": "咋了？昨天给他们讲的段子没听懂吗？多有意思的笑话啊真是...",
    "4": "以前这儿可是大伙儿散步的好地方。唉！这世道...",
    "5": "真不该把那年那件紫西装给扔了的，现在好了...",
    "6": "迪蒙，最近这货出动得也太勤快了吧。想钱想疯了？",
    "7": "眼下塔科夫就这点不好，兄弟。连本像样的带妞杂志都搞不到。",
    "8": "行啊，要是迪蒙再给我带堆垃圾回来...我非得埋了他。",
    "9": "都快没地方埋这帮死鬼了。",
    "10": "雷布伊这小子还想休假？当我人事局呢？",
    "11": "等我赚够钱了，就马上离开这个破地方。",
    "12": "哈哈妈的，怎么突然想起这些事了。",
    "13": "狙击手就位。守住警戒点，确保没有闲杂人等靠近。",
    "14": "唔唉——妈的，真想来场热身运动啊！",
    "15": "可惜没有女人来这里。",
    "16": "妈的我让那小子给诈了！昨天卖老子的根本就是空枪！操他妈的！",
    "17": "兄弟们盯紧了，别放任何杂碎过来！",
    "18": "都愣着干啥？动起来！去看看外围！",
    "19": "够了够了！别他妈哭哭唧唧跟娘炮似的！完事儿请你们喝酒！",
    "20": "迪蒙昨天讲的黄段子咋讲来着？妈的死活都想不起来！",
    "21": "注意观察两边！",
    "22": "还记不记得咱上次咋把澡堂子给炸塌的？呃哈哈哈！！！",
    "23": "迪蒙，你再磨洋工，老子马上让你永远合眼。",
    "24": "就这帮软脚虾，走道儿都费劲，在这活不过两分钟。嘿嘿。",
    "25": "(哈欠声)",
    "26": "迪蒙把你那烧火棍收起来！...操，看错人了，管他妈的！",
    "27": "得给安琪儿打个电话了，好久没听到她声音了。",
    "28": "昨天非要塞给我这破玩意儿干啥？嫌我死得不够快是吧！",
    "29": "无聊死了...迪蒙，讲个笑话听听，我快闲出尿了。",
    "30": "唉，早些年这片儿可比现在带劲多了。",
    "31": "这都什么鬼日子，无聊死了。",
    "32": "还总说九十年代多惨？哈！搞笑！让他们来这儿试试呢！喝哈哈哈！！！",
    "33": "再熬一阵子，等翻过这个坎儿就轻松了。",
    "34": "兄弟们！谁那儿有烟？憋死了！",
    "35": "一，二，三...妈的得雇个会计来数子弹了。",
    "36": "瞅瞅周围，动静不对。去！",
    "37": "土豆泥还是破面条？这有啥可选的。",
    "38": "别干瞪眼发呆了。",
    "39": "振作起来兄弟们。",
    "40": "都机灵点儿，别跟菜鸟似的丢人！",
    "41": "(懒腰哈欠声)",
    "42": "要是我带着花去找她？她能原谅我不？",
    "43": "行了兄弟们别慌，明天就有票子了。",
    "44": "宝刀未老。",
    "45": "妈的，还不如继续在坟场看场子呢。",
    "46": "得赶紧把藏着的钱都拢到一块儿。",
    "47": "全体注意！立即散开警戒，把每个角落都给老子搜干净！",
    "48": "净来些不长眼的菜逼，最后还得老子给他们擦屁股。",
    "49": "多半是风声。",
    "50": "真该整两口伏特加。",
    "51": "操！今天这破歌词又写不完了！",
    "52": "弟兄们今晚都别走！我要亲自给你们一展歌喉！",
    "53": "以前养过只三花猫...玛什卡，愿你在那边睡得安稳。",
    "54": "迪蒙，上回晾的鱼干还有剩没？",
    "55": "这日子够舒坦！可老子还想更得劲！喝哈哈哈！！！",
    "56": "兄弟们管好自己的臭嘴。",
    "57": "麻子你他妈抽什么风？活腻了是吧。",
    "58": "今晚你放哨。",
    "59": "搞定，兄弟们。",
    "60": "那批货必须吃掉。",
    "61": "昨天几个傻逼敢阴老子，找死也不挑人！",
    "62": "都别垂头丧气的了兄弟们，看着就晦气。",
    "63": "安托哈那小子是条好汉...可惜了。",
    "64": "晚上给兄弟们整段地道的老炮儿曲子。",
    "65": "迪蒙，今晚你站哨。",
    "66": "行了，我得跟兄弟们通个气儿。派两个人去竞技场清个场。",
    "67": "好了，家伙得带上竞技场。",
    "68": "好了，正事要紧...该去竞技场捞点钱了。",
    "69": "真他妈晦气，在这鬼地方干耗着。",
    "70": "行了，我要跟他们谈谈。派几个人去竞技场那边看看。",
    "71": "我什么都知道...",
    "72": "(嘀咕声)",
    "73": "(咂舌声)",
    "74": "(呼吸声)",
    "75": "(呼吸声)",
    "76": "(呼吸声)",
    "77": "(嘀咕声)",
    "78": "(嘀咕声)",
    "79": "(嘀咕声)",
    "80": "这鬼日子什么时候才是个头。",
    "81": "呵。",
    "82": "呵。",
    "83": "喏。",
    "84": "呃？",
    "85": "唔。",
    "86": "唔。",
    "87": "唔。",
    "88": "呵呵。",
    "89": "嗯。",
    "90": "呃。",
    "91": "咳咳。",
    "92": "咳。",
    "93": "咳。",
    "94": "咳咳。",
    "95": "咳。",
    "96": "咳。",
    "97": "呵呵啊哈哈哈...",
    "98": "哈哈！",
    "99": "呃哈哈哈哈哈...",
    "100": "哈哈！",
    "101": "喝呵呵哈哈哈哈哈...好的，尼基塔。哈哈哈...",
    "102": "呃呵哈哈哈...咳咳...我的天...",
    "103": "兄弟们，清一圈外围。",
    "104": "别拿破铁皮当乐器耍了，弟兄们！",
    "105": "狙击手！注意一下四周。"
  },
  "OnRepeatedContact": {
    "0": "我向你保证...",
    "1": "哈哈，看来你的生活真不如意了，不然怎么会跑到这里来。",
    "2": "他还在那跑！",
    "3": "这他妈哪来的纸老虎在这装大人物？",
    "4": "毒刺插错地方了，傻逼。",
    "5": "你已经在我准星里了，杂种。",
    "6": "现在就把你肠子里的东西都掏干净。",
    "7": "马上——砰砰！——你就死了，痛快点的！",
    "8": "上啊兄弟们！",
    "9": "马上要有人蹬腿儿了，反正不是我！",
    "10": "不要朝那边开枪！",
    "11": "哟！又来个“舒里克”送快递了。呵哈哈！"
  },
  "OnWeaponReload": {
    "0": "换弹！我子弹打空了！",
    "1": "没子弹了！",
    "2": "妈的弹匣打空了！",
    "3": "停火！换弹！",
    "4": "掩护我换弹！"
  },
  "WeaponBroken": {
    "0": "妈了个逼的卡壳！",
    "1": "这！个！破！烂！给老子动起来！",
    "2": "卡壳，你们先顶住！",
    "3": "他妈的，这破铜烂铁毛病真他妈多！"
  },
  "OnWeaponJammed": {
    "0": "我先处理卡弹！",
    "1": "今天这破枪尽跟我作对！",
    "2": "偏偏在这节骨眼上卡壳！",
    "3": "操他妈逼的又卡壳！",
    "4": "兄弟们，我武器卡死了！",
    "5": "破枪卡壳了。"
  }
}
