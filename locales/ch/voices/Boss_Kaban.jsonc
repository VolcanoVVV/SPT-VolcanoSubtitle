{
  "BadWork": {
    "0": "唔，你个卑鄙小人真阴...我竟然没反应过来。",
    "1": "唉！真怀念过去的好时光啊！"
  },
  "HandBroken": {
    "0": "呃！操他妈的。刚开始手就断了。",
    "1": "唔！手动不了了。呃嗯！",
    "2": "呼...希望Sanitar能念在旧情，给我缝两针"
  },
  "LegBroken": {
    "0": "呃！为什么打中的是腿？",
    "1": "操！科祖林老大绝不会放过你的！",
    "2": "呃啊！啊...自95年起...我就再没尝过这种剧痛了。呃..."
  },
  "EnemyDown": {
    "0": "拒收菜逼。",
    "1": "干得漂亮，兄弟们！",
    "2": "我给你们钱可不是白送的。",
    "3": "把他当叶子飞了！",
    "4": "搞定一个。"
  },
  "OnFight": {
    "0": "老子这就给你“加点料”！",
    "1": "你曾是我最犀利的武器...哎，如今何在？",
    "2": "我要把你当罐头开了！",
    "3": "去找点靶子打一打吧！哈哈哈哈哈！",
    "4": "像畜生一样被我屠宰吧！",
    "5": "呵呵哈哈哈哈哈！！！",
    "6": "呵呵哈哈哈哈哈！！！",
    "7": "看来你是真活腻了。",
    "8": "死吧！",
    "9": "狙击手瓦列夫！",
    "10": "该休息时休息，该爆头时爆头！",
    "11": "狙击手？已经给他开了天窗。",
    "12": "该死的家伙，瞄准点！",
    "13": "别怂，从右侧包抄过去！",
    "14": "到他左边去！",
    "15": "干得漂亮，兄弟们！把这帮混蛋全给我宰了！",
    "16": "狙击手，掩护我！",
    "17": "呃哈哈！哒哒哒哒哒哒！哈哈哈！"
  },
  "GetInCover": {
    "0": "全体后撤！"
  },
  "HurtHeavy": {
    "0": "(疼痛呻吟声)",
    "1": "唔...这次...运气没站在我这边。",
    "2": "呃...居然要死在这么个没用的废物手里。",
    "3": "...真痛苦啊...",
    "4": "迪蒙接手指挥，如果他还没死的话...咳咳..."
  },
  "HurtLight": {
    "0": "唔！妈的，这疯狗还会开枪。",
    "1": "呃！被你这个混蛋玩意儿打中了。"
  },
  "HurtMedium": {
    "0": "呃！我中弹了！",
    "1": "妈的！狗操的...杂种！",
    "2": "操！操！操！"
  },
