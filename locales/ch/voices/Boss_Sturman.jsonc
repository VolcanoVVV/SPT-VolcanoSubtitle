{
  "Look": {
    "0": "敌人可能躲在灌木里了，给我一个个查。",
    "1": "每个方向都要确认一遍。",
    "2": "都把眼睛睁大点。"
  },
  "BadWork": {
    "0": "该死，这家伙真有点东西……没料到啊。",
    "1": "该死，这家伙真有两下子，失算了。",
    "2": "下次别再打空了，听明白没有？",
    "3": "下次别再掉链子了。",
    "4": "挺黏牙啊，小子。"
  },
  "HandBroken": {
    "0": "呃！操，肩膀中了一下！",
    "1": "该死，手臂被打穿了！",
    "2": "呃！我这只手废了！"
