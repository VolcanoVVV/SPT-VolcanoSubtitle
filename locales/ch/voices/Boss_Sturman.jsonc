  "OnDeath": {
    "0": "原来是这种感觉……有意思。",
  "1": "我倒下了...替我报仇杀了他。",
  "2": "叹...真是恶心的感觉。",
  "3": "...咳果然，我最后还是把他解决了。"
  },
  "OnEnemyDown": {
    "0": "目标清除。",
    "1": "目标清除。哼哼。",
    "2": "早该护着点脑袋了。",
    "3": "早该护着点脑袋了。"
  },
  "OnEnemyGrenade": {
    "0": "进掩体！",
  "1": "手雷！",
  "2": "往两边散开，小的们！两边！",
  "3": "手雷！散开！"
  },
  "OnEnemyShot": {
    "0": "正中靶心。",
  "1": "砰！爆头！",
  "2": "后悔跑来凑这个热闹了吧？",
  "3": "子弹面前，你躲不掉的。",
  "4": "来吧，去死。",
  "5": "你好啊，PMC老兄？",
  "6": "你就不该踏进我的地盘。",
  "7": "等下你就得把自己的脑浆从墙上刮下来了，畜生。",
  "8": "正中靶心。",
  "9": "现在还不想求饶吗？",
  "10": "你是个废物，死也还是个废物。",
  "11": "去死，来吧！"
  },
  "OnFirstContact": {
    "0": "目标正朝我们这边移动！",
  "1": "目标就在附近！",
  "2": "把他们当流浪狗一样点了！",
  "3": "包抄他们！",
  "4": "来吧，让我看看你有几斤几两！",
  "5": "来吧，让我看看你有能耐到什么程度。",
  "6": "目标很近！",
  "7": "我能一枪把你脑袋打穿！"
  },
  "OnGoodWork": {
    "0": "就会叫唤啊，狗东西，接着来咬我啊。",
  "1": "这点本事，太弱了。"
  },
  "OnGrenade": {
  "0": "拿着，这是给你的！",
  "1": "接好这颗！",
  "2": "去捡！",
  "3": "尝尝烫手山芋！"
  },
  "OnLostVisual": {
    "0": "出来！我只是想跟你好好聊聊而已。",
    "1": "他跑哪儿去了？每个角落都给我查一遍！",
    "2": "汇报当前情况！",
    "3": "瞄准镜里看不见他！",
    "4": "他脱离射程了！目标丢失！",
    "5": "需要重新侦察现场情况！",
    "6": "敌人正在撤退！"
  },
  "OnMutter": {
    "0": "都别放松。记住森尼是怎么。",
  "1": "完事了再去喝一杯。",
  "2": "叶夫根尼，别在那儿瞎折腾了。",
  "3": "谢廖加，根尼，这边清干净了吗？",
  "4": "要是能去钓钓鱼就好了...",
  "5": "现在来杯热茶该多好...",
  "6": "谢廖加！谢廖加！跑灌木里去了？",
  "7": "这处点位必须守住。",
  "8": "要早知道在锯木厂干活会变成这样的话...",
  "9": "不知道能不能从塔尔科夫寄封信出去。",
  "10": "叶夫根尼，汇报一下情况。",
  "11": "叶夫根尼，汇报情况。",
  "12": "得把那个猎人给做了，他老是给我使绊子，烦死人了。",
  "13": "谢廖加，回话，现在什么情况？",
  "14": "谢廖加，汇报。",
  "15": "回头得把张沙发拖到这儿来。",
  "16": "盯紧这片区域！",
  "17": "这儿木头多得，都能直接盖个澡堂了。",
  "18": "昨天那帮家伙又冲过来了，没办法，全都给放倒了。",
  "19": "(歌词大意)什么是秋天？是天空，是在脚下哭泣的天空！",// 出自 DDT 乐队《Что такое осень》（《什么是秋天》）。
  "20": "得给兄弟们安排点训练了，一个个都松懈了。",
  "21": "记得以前在这儿干过活，回忆不咋地。",
  "22": "别被这些小事分心。",
  "23": "差不多了，兄弟们。完事儿就去喝点伏特加。",
  "24": "谢廖加，别在岗上犯困！狼会咬你侧腰的！",
  "25": "以前还爱过塔季扬娜，那会儿真是好时候。",
  "26": "今天又有多少傻逼想来要我的命？",
  "27": "得再找一条烟了，上一条抽得太快。",
  "28": "今天天气真好，好到想宰个人。",
  "29": "得给所有人立个样子，让他们以后别再硬冲。",
  "30": "敌人可能猫在灌木里，一个个给我检查。",
  "31": "每个灌木都要检查。",
  "32": "这情况又开始稳定下来了。",
  "33": "得提醒谢廖加一声，别再把尸体往水里扔。",
  "34": "(口哨声)",
  "35": "嗯，要我没弄错的话，情况也就那样...",
  "36": "今天这儿安静得出奇...",
  "37": "这处点位必须守住...",
  "38": "谢廖加，说多少遍了？活要干正常的，别整那些不正常的。",
  "39": "待在这儿总比在船上强。",
  "40": "今天这儿真是安静得很...",
  "41": "咳咳...",
  "42": "咳咳...还不能病倒。",
  "43": "咳咳...",
  "44": "咳咳...",
  "45": "在塔科夫，一切变化得太快了。",
  "46": "这安静挺好，挺平静的。",
  "47": "这安静得有点要命。",
  "48": "哈...不能睡。",
  "49": "哈...等到了那边再睡个够。",
  "50":"(伸懒腰声)",
  "51": "哈...以前我能在狙位上一坐就是好几天。",
  "52": "要是我爸现在能看到我就好了。可惜他已经不在了。",
  "53": "现在这地方，安静得让人不习惯。",
  "54": "要不养条狗算了？",
  "55": "又来烦我了。他到底什么时候回话？",
  "56": "不知道Therapist医生这次还会不会露面。",
  "57": "得再买点子弹，消耗得太快了。",
  "58": "又得他妈重新招人。真不该把我列进来，真是操了。",
  "59": "得让所有人都明白，最好别来惹我这个猎手。",
  "60": "谢廖加，说多少遍了？活要干正常的！不正常的，别干！",
  "61": "都给我保持警惕！",
  "62": "别从岗哨上分心！"
  },
