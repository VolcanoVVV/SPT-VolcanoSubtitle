{
  "HandBroken": {
    "0": "妈的，手被打中了。"
  },
  "LegBroken": {
    "0": "腿被打中了。",
    "1": "妈的，我的腿..."
  },
  "OnFight": {
    "0": "喝哈哈哈哈哈！！！",
    "1": "啊哈哈哈哈哈！！！",
    "2": "命中！",
    "3": "直接命中！",
    "4": "你他妈的会飞吗？",
    "5": "但愿你接受过洗礼！",
    "6": "准备去死吧！",
    "7": "去死吧，畜生！",
    "8": "倒下吧！",
    "9": "再次拿起武器的感觉真不错！",
    "10": "懦夫！",
    "11": "他跑哪去了？",
    "12": "出来见见阳光吧，混蛋！",
    "13": "你躲在哪了，混蛋！",
    "14": "跑吧！跑吧！无论如何你都会再次落入我的陷阱。",
    "15": "哈哈哈哈哈！！！",
    "16": "连个老头儿都打不过。",
    "17": "在塔科夫这种人这么多吗？需要清理一下。",
    "18": "塔科夫又出现垃圾了。",
    "19": "我恳请各位。",
    "20": "你走错地方了，小子。",
    "21": "白跑一趟。",
    "22": "我看到你了。",
    "23": "塔科夫会重获自由。",
    "24": "送你回仓库去吧。",
    "25": "这里不欢迎你！",
    "26": "这不是你该来的地方",
    "27": "没人会为你哀悼",
    "28": "可惜你当时没能逃离塔科夫！",
    "29": "你在这瞎晃什么呢？",
    "30": "你最好快跑。",
    "31": "你的尸体只配给塔科夫当肥料。",
    "32": "马上又要少一个人了。",
    "33": "给我滚开！",
    "34": "你兄弟就等着捡你的碎尸吧！",
    "35": "塔科夫不是你的地盘。",
    "36": "你们的归宿是坟墓。",
    "37": "你的脸会被打烂，盗墓者。",
    "38": "有种就像个男人一样挺住！",
    "39": "你就躺在这吧。",
    "40": "你无法活着离开这片森林。",
    "41": "为了塔科夫！",
    "42": "去死吧，混蛋！",
    "43": "你会永远躺在这里！",
    "44": "你可以把脑袋留在这儿。",
    "45": "为了操你！",
    "46": "你在自寻死路。",
    "47": "又来自寻死路了，你这混蛋。",
    "48": "不速之客来了。",
    "49": "这地盘现在有主了，小子！"
  },
  "Greetings": {
    "0": "你好。",
    "1": "你好。",
    "2": "祝你身体健康，亲爱的。",
    "3": "你迷路啦？",
    "4": "欢迎来到森林！",
    "5": "祝你健康，亲爱的！",
    "6": "欢迎来到森林！"
  },
  "HurtHeavy": {
    "0": "(疼痛喊叫声)",
    "1": "(疼痛喊叫声)",
