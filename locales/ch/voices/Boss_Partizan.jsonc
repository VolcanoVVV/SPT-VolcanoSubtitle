  "HurtLight": {
    "0": "你以为这样就能打烂我吗？",
    "1": "我受够这帮杂种了。",
    "2": "小伤而已。"
  },
  "HurtMedium": {
    "0": "操，这畜生打中我了！",
    "1": "打中我了，混蛋。",
    "2": "呃嗯..."
  },
  "LowKarmaAttack": {
    "0": "你是为塔科夫的事来的？",
    "1": "塔科夫没有你会变得更好。",
    "2": "你来我的森林真是白跑一趟。",
    "3": "你就不该来这多管闲事。",
    "4": "你以为我不知道你犯下的罪行吗？",
    "5": "像你这样的人必须清除。",
    "6": "去死吧，垃圾。",
    "7": "你再也见不到明天的太阳了。"
  },
  "KnifeKill": {
    "0": "教堂需要清理。",
    "1": "没有你会更好。",
    "2": "别乱动...",
    "3": "呐。",
    "4": "接招吧，废物。",
    "5": "死吧。",
    "6": "你的死期到了。",
    "7": "这是给坦克的吗？"
  },
  "Mine": {
    "0": "免费送你去焚化炉！",
    "1": "塔科夫又少了一个败类。",
    "2": "美妙的声音。",
    "3": "中招了吧！肠子都挂树上了。",
    "4": "有人勾到拌线了。",
    "5": "肠子绘画课开课啦。",
    "6": "乱走的下场！",
    "7": "上钩了。",
    "8": "这片地什么都有。",
    "9": "努力没有白费。",
    "10": "有人走路不长眼睛啊。呵呵呵...",
    "11": "拌雷完美触发了。",
    "12": "这烟花真好看。",
    "13": "第一个死了。",
    "14": "就是这样！",
    "15": "好样的！下次记得看看脚下。",
    "16": "陷阱触发了。",
    "17": "刚才人还在那呢，现在都不见了。"
  },
