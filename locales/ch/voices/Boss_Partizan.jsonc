  "OnDeath": {
    "0": "不...不该这样。",
    "1": "连教堂...也不再神圣了么？",
    "2": "叹...这不可能...",
    "3": "我的路，到此为止了...",
    "4": "把我葬在...那棵橡树下...",
    "5": "Jaeger...现在要你一个人扛下所有了...",
    "6": "Jaeger！现在，只剩你一个人扛下所有了...",
    "7": "不该是这样...",
    "8": "不...不该这样，我来不及了。",
    "9": "我变得脆弱了。",
    "10": "不可能。"
  },
  "OnEnemyGrenade": {
    "0": "手雷！",
    "1": "妈的，有手雷！",
    "2": "天呐，是手雷！"
  },
  "OnGrenade": {
    "0": "接住。",
    "1": "这是给你的！",
    "2": "这是你的。"
  },
  "OnMutter": {
    "0": "这片土地不容任何杀人犯存活。",
    "1": "需要装点拌雷了。",
    "2": "还需要其他零部件，很快就要用完了。",
    "3": "需要取反步兵地雷。",
    "4": "有人在森林里散步散的挺舒服啊。呵呵呵...",
    "5": "用那些败类的尸体向森林神致敬。",
    "6": "真得好好清理一下了。",
    "7": "在森林里基本没人会低着头走路，我会教会他们的。",
    "8": "该去拜访一下Jaeger了，他或许有新的情况。",
    "9": "Jeager那儿有好货，得给他带点“骨头”当见面礼。",
    "10": "这种情况真的糟糕透了。",
    "11": "有人在拆我的拌雷，找到他我会砍了他的手。",
    "12": "用不了多久，教堂就又会成为一个好地方。",
    "13": "我记得那会儿这里不像现在这么安静。",
    "14": "今天谁会落入我的陷阱呢？",
    "15": "嗯。",
    "16": "嗯...",
    "17": "哈。",
    "18": "嗯...",
    "19": "随后我得检查一下西区的拌雷。",
    "20": "保持警惕，现在森林里什么人都可能会有。",
    "21": "目前还算安静，我来检查一下陷阱。",
    "22": "不是清理森林角落，是清扫整片地区。",
    "23": "你很快又会被赶走。",
    "24": "得趁蘑菇还没绝迹，多采点备着。",
    "25": "哈哈哈哈...",
    "26": "哈哈哈...",
    "27": "咔哈哈哈...",
    "28": "呵呵呵呵....",
    "29": "现在真想来碗老妈做的热汤啊...可她人在哪呢？",
    "30": "一刻不得安宁。",
    "31": "需要追加拌雷部署了。",
    "32": "呼...再多走一步你就要睡觉了。",
    "33": "教堂里的事迟早会好起来的。",
    "34": "必须在他们来之前布置完。",
    "35": "再走一段就能休息了。"
  },
