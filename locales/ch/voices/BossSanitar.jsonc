{
  "SniperPhrase": {
    "0": "狙击手！",
  "1": "操，什么鬼情况？到底是谁在开枪？",
  "2": "行了，同事们，这附近有个狙击手...还他妈在给我吃子弹呢。"
  },
  "OnFight": {
  "0": "很好，开始处理病人了。",
  "1": "好好好好，接诊开始了！",
  "2": "喂，你那边是出什么问题了？",
  "3": "喂，你那边是不是有点毛病？",
  "4": "你脑子里是装了个大便吗？！",
  "5": "这边是ICU重症现场！",
  "6": "现在我就让你见识下什么叫“手术”！",
  "7": "你看见了吗？！",
  "8": "滚蛋，去你妈的！听得懂不！",
  "9": "我就是你的止血带！",
  "10": "安静点！",
  "11": "哎哟哟，已经疼到飞起了！",
  "12": "疯了！那家伙真他妈是疯了！",
  "13": "你的裹尸袋已经给你准备好了！",
  "14": "它来了！他来了！唰唰唰唰唰！",
  "15": "来了！来了！唰唰唰！",
  "16": "哟哟，怎么了？还有活着的吗？",
  "17": "这家伙，看来得来个激进点的治疗方案了！",
  "18": "保持射击，冷静点，别紧张！",
  "19": "我真是年轻又活力啊，呜呼——！",
  "20": "咔嚓咔嚓咔嚓咔嚓咔嚓咔嚓！",
  "21": "那你这是在搞什么鬼？！",
  "22": "滚你妈的！",
  "23": "你有病吧，混账东西！",
  "24": "操，真他妈该死，婊子养的！",
  "25": "压制！压制！",
  "26": "压制！压制！",
  "27": "把他带走！",
  "28": "把他带走！"
  },
  "FollowMe": {
    "0": "回家，同事们！",
  "1": "回家，同事们！",
  "2": "快，跟我来！快！",
  "3": "快，跟我来！快！",
  "4": "跟我来！快！",
  "5": "好，所有人靠我这边，走！",
  "6": "好，所有人靠我这边，走！",
  "7": "好，所有人靠我这边，走！",
  "8": "跟我走，同事们！快！"
  },
  "FriendlyFire": {
  "0": "你他妈几岁了还在犯蠢，脑残吗？",
  "1": "你往哪儿开枪呢？我现在就给你开个“治疗方案”，狗娘养的！",
  "2": "我给你开张证明，转诊单跟张纸片一样！哈哈哈。",
  "3": "资源就这么点，一个小破系统！",
  "4": "你这狗东西，同事们，我们这有叛徒！"
  },
  "GetInCover":{
  "0": "我朝前推进，你们掩护我。",
  "1": "我前去侦察。",
  "2": "我去检查，你们来配合。",
  "3": "行，我上去动手术，你们掩护。",
  "4": "他妈的躲好！",
  "5": "马克斯，躲快点！"
  },
  "HandBroken": {
    "0": "啊！他们弄断我手臂了，我得去趟抢救室。"
  },
  "HurtHeavy": {
    "0":"(疼痛声)",
"1":"(疼痛声)",
"2":"(疼痛声)",
"3":"(疼痛声)"
  },
  "HurtNearDeath": {
  "0": "叹，算了。打针也救不了我了。我完蛋了...",
  "1": "诸位，我已经快跟生命体不相干了。"
  },
  "LegBroken": {
    "0": "啊！！！我这胫骨他妈的是要命的骨折！啊——！",
  "1": "啊！！！我这胫骨怕是双重骨折了，啊——！"
  },
  "LootBody": {
    "0": "这儿有个躺平休息的尸体。",
  "1": "戴上手套，开始检查。",
  "2": "看看他怎么回事，怎么就躺下了。"
  },
  "LootContainer": {
    "0": "来，把这儿都检查一遍。",
  "1": "同事们，干活了！"
  },
  "OnMutter": {
    "0": "我们这是在巡查还是怎么的？继续往前走。",
  "1": "行了，这儿没什么可干的了，撤。",
  "2": "那就开始巡查吧。要是冒出闹事的，别忘了打针。",
  "3": "跟停尸房一样，安静得要命，一个活的都没有！",
  "4": "跟停尸房一样，安静得要命，一个活的都没有！",
  "5": "安静，所有人，别出声。",
  "6": "动身。",//?
  "7": "得顺路去一趟挂号处。",
  "8": "得顺路去一趟挂号处。",
  "9": "哦——这当然是个被拖烂了的病例。",
  "10": "回头还得去一趟卡尔维尔。",
  "11": "转告肛肠科医生一声，他那边病人又多了。",
  "12": "消毒真是医学发明里最靠谱的东西。",
  "13": "别去压当地人，那边还是有正常人，有好好干活的。",
  "14": "同事们，你们知道该干什么。一直掩护我，我可是那个又善良又好心的。",
  "15": "打针打针。刚开始咳嗽时——打一针。",
  "16": "还记得那些机关里的家伙把我们拉去靶场的时候吗，嗯？肛肠科医生应该记得吧。",
  "17": "这帮人把这儿搞得一团糟，结果还得我一个人来收拾。",
  "18": "同事们，打起精神来，我们可还有世界要拯救呢！",
  "19": "吵闹得要死，根本没法干活。",
  "20": "森林里的卫生员，我就是卫生员。——卫生员小哥。",
  "21": "哦对，我们这可不能缺了外科医生。",
  "22": "走了走了！",
  "23": "进！进！进！",
  "24": "直走，走啊，快点！",
  "25": "直走，给我动起来！",
  "26": "好，红色针我扔到围栏那边了，白色针好像还在我身上。",
  "27": "你跟我说过的，米沙，说什么卫生员走短巡逻路线不合适，老远就能被看见。",
  "28": "心脏科那家伙上周真是整了个大的，结果后来还得我从他身上把铅掏出来。",
  "29": "然后就是这个，走250号这条线。行行，对，对，计划还不错。",
  "30": "接着，嗯，走210号那边。行行，对，对，计划还不错。",
  "31": "脑袋倒是一点都不疼。",
  "32": "小猫不疼，小狗也不疼。",
  "33": "夏天在疗养院里确实挺舒服的。",
  "34": "注射器别扔，我待会儿还能用上。",
  "35": "他需要担架。我跟他说没担架，他还非要我去抬，真是个彻头彻尾的傻子。",
  "36": "我当时就跟他们说过，毒力会不一样，疫苗根本没准备好，也不会那么快扩散，嗯。",
  "37": "等到实验室第三阶段开始的时候，他们那会儿给我调来了TJ 6T，之后那些机关里的家伙才开始介入，还是没有？不对，那应该不是今年，那是哪一年来着？",
  "38": "还记得那些机关里的家伙把我们拉去靶场的时候吗，嗯？肛肠科医生应该记得吧。"
  },
