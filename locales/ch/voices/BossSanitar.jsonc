  "OnEnemyDown": {
    "0": "手术完成得很漂亮，各位！",
  "1": "同事们，这次手术给你们打满分！",
  "2": "要不，洗手收工？",
  "3": "看来，我们把这些疯子给安抚下来了。",
  "4": "看来，我们把这些疯子给安抚下来了。",
  "5": "看来，我们把这些疯子给安抚下来了。",
  "6": "病房一切平静，同事们。",
  "7": "病房一切平静，同事们。",
  "8": "可以了，那家伙蹦跶完了！",
  "9": "把那混蛋处理掉了！行了，给他打包！",
  "10": "结束了，抢救已经没用了！给他打包吧！哈哈哈...",
  "11": "哈哈哈，解决了！他死了！",
  "12": "哈哈哈，解决了！他死了！"
  },
  "OnEnemyGrenade": {
    "0": "这儿有手雷！",
  "1": "闪开！手雷！"
  },
  "OnEnemyShot": {
    "0": "有了！把他给打趴下了！",
  "1": "这一针扎得准！",
  "2": "对就这样，吃我一针！"
  },
  "OnFirstContact": {
    "0": "来人了！来人了！",
  "1": "同事们，同事们，后撤，后撤！",
  "2": "放狗进来！",
  "3": "把这条臭狗往火炉里架！",
  "4": "有个当兵的来接诊了！",
  "5": "滚你妈的，Fuck off！听懂没？！",
  "6": "你好！朋友！",
  "7": "抱歉啊，我们这儿不这么说话。",
  "8": "上面派来的，滚开！",
  "9": "上面派来的，现在我就给他们下诊断！只有一个诊断结果——死亡！",
  "10": "哟！这儿有个活着的，不是自己人！"
  },
  "OnFriendlyDown": {
    "0": "完了，我们这是直通停尸房了。",
  "1": "看样子是被这帮疯子给收拾了。",
  "2": "完了，我们这是直通停尸房了。",
  "3": "坏了，同事们，我们这儿出事了！",
  "4": "坏了，同事们，我们有伤亡！",
  "5": "这他妈是谁飞过来的？操，一群畜生！",
  "6": "他们这是要把我们摁土里啊，杂种！"
  },
  "OnGrenade": {
    "0": "给你开颗手雷偏方！",
  "1": "拿好诊断单，狗娘养的！",
  "2": "就这么给你开一罐，吃着吧！"
  },
  "OnLostVisual": {
  "0": "停停停停停，找找，找找！",
  "1": "停停停停停，找找，找找！",
  "2": "仔细找，他们就在这附近晃。",
  "3": "仔细看看，他们到底在哪儿晃。",
  "4": "同事们，声音放低点。",
  "5": "喂，喂，出来！你干嘛呢，跑哪儿去了？",
  "6": "怎么不吭声了？怂了？",
  "7": "出来吧！我这儿给你准备了点‘配件’！",
  "8": "好好好好好，看着，看着！",
  "9": "好好好好好！盯着，盯着，盯着！",
  "10": "他在这儿，就在这儿，我能感觉到！",
  "11": "塞德里坦！塞德里坦！继续搜，他们就在这附近！",
  "12": "操他妈的，继续找，找出来，那个杂种！",
  "13": "喂——喂——出来吧，朋友！就打几针，一切就结束了！",
  "14": "喂——喂——出来吧，朋友！就打几针，一切就结束了！",
  "15": "我们就这么潜着？安静！",
  "16": "冷静，同事们！",
  "17": "都趴着，别乱动！"
  },
  "NeedAmmo": {
    "0": "子弹清空了！",
  "1": "子弹清空了！",
  "2": "没法‘治疗’了，子弹用完了！",
  "3": "同事们，谁给我扔点“药丸”？",
  "4": "我没子弹了！",
  "5": "子弹打光了，可我这边活儿还多着呢！",
  "6": "在装弹！",
  "7": "在装弹！",
  "8": "换弹中！",
  "9": "换弹中！",
  "10": "我这“药丸”用完了，正在换弹！"
