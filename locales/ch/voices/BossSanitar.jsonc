  "OnRepeatedContact": {
     "0": "这就是我们的病人了。",
  "1": "这就是我们的病人了，一个一个来接诊。",
  "2": "正前方！",
  "3": "正前方！",
  "4": "正前方有个病人！",
  "5": "正前方有个病人！",
  "6": "同事们，正前方开火，正前方！给他治一治！",
  "7": "同事们，开火！正前方，正前方！",
  "8": "看见了，在那儿！",
  "9": "他就在那边，开火！"
